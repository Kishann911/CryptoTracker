# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store


# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ============================================================================
# SECURITY: Firebase & Sensitive Credentials
# ============================================================================
# CRITICAL: These patterns protect sensitive Firebase credentials from being
# committed to version control. Never remove or modify these patterns.
# ============================================================================

# Firebase service account files (contain private keys - NEVER commit)
firebase-service-account.json
*-service-account.json
*-service-account-key.json
serviceAccountKey.json
serviceAccount.json

# Google Cloud credentials
*-credentials.json
google-credentials.json
gcloud-credentials.json

# Firebase config files with secrets
firebase-config.json
firebase-adminsdk-*.json

# Any JSON files in .firebase directory
.firebase/*.json
!.firebase/firebase.json

# Private keys
*.pem
*.key
*.p12
*.pfx


# Log files
*.log

# Runtime data
*.pid
*.seed
*.pid.lock

# Diagnostic reports
*.diag

# Database files
*.db
*.sqlite

# Temporary folders
tmp/
temp/

# IDE files
.vscode/settings.json
.idea/

# OS generated files
Thumbs.db
ehthumbs.db
Icon?